<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- Header / Action Bar (Sleek Professional Design) -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#1E3A8A"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:elevation="4dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enterprise Secure Chat"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvConnectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Terhubung | Auto-Sync Active"
                android:textColor="#93C5FD"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCheckUpdate"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Cek Pembaruan"
            android:textSize="11sp"
            android:backgroundTint="#3B82F6"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Professional Status Banner -->
    <TextView
        android:id="@+id/tvBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EFF6FF"
        android:paddingVertical="10dp"
        android:paddingHorizontal="16dp"
        android:text="Sistem Terhubung. Seluruh komunikasi dan data tersimpan secara aman."
        android:textColor="#1E40AF"
        android:textSize="12sp"
        android:gravity="center" />

    <!-- Authentication Panel (Login & Account Registration) -->
    <LinearLayout
        android:id="@+id/authPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_margin="16dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/tvAuthTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Autentikasi Pengguna"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1F2937"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Silakan masuk atau daftarkan akun resmi Anda untuk memulai sesi."
            android:textSize="12sp"
            android:textColor="#6B7280"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etAuthUser"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Nama Pengguna (Username)"
            android:background="#F3F4F6"
            android:paddingHorizontal="12dp"
            android:textSize="14sp"
            android:lines="1" />

        <EditText
            android:id="@+id/etAuthPass"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Kata Sandi (Password)"
            android:inputType="textPassword"
            android:background="#F3F4F6"
            android:paddingHorizontal="12dp"
            android:textSize="14sp"
            android:lines="1"
            android:layout_marginTop="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Masuk (Login)"
                android:backgroundTint="#1E3A8A"
                android:textColor="#FFFFFF" />

            <View
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btnRegister"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Daftar Akun Baru"
                android:backgroundTint="#059669"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Chat Container Panel -->
    <LinearLayout
        android:id="@+id/chatMainPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Scrollable Chat Messages -->
        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <LinearLayout
                android:id="@+id/chatContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- Message Input Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:elevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvLoggedInUser"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sesi Aktif: -"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#374151" />

                <Button
                    android:id="@+id/btnLogout"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Keluar Sesi"
                    android:textSize="10sp"
                    android:backgroundTint="#EF4444"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/etMessage"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:hint="Tulis pesan resmi..."
                    android:background="#F3F4F6"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnSend"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:text="Kirim"
                    android:backgroundTint="#1E3A8A"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
